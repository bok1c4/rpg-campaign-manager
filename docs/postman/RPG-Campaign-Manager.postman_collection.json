            "body": { "mode": "raw", "raw": "{\n  \"title\": \"The Lost Mines of Singidunum (Remastered)\",\n  \"description\": \"Updated description.\",\n  \"setting\": \"Forgotten Realms\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/campaigns/1", "host": ["{{baseUrl}}"], "path": ["api", "campaigns", "1"] }
          },
